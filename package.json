{
  "name": "taskhive",
  "version": "1.0.0",
  "scripts": {
    "frontend:dev": "cd frontend && npm run dev",
    "backend:dev": "cd backend && nodemon index.js",
    "install-deps": "cd backend && npm i && cd ../frontend && npm i",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run backend:dev\" \"npm run frontend:dev\""
  },
  "dependencies": {
    "concurrently": "^10.0.5"
  }
}
